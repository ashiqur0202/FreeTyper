{
  "name": "freetyper",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/migrate.mjs && next start",
    "lint": "eslint",
    "check:text": "node scripts/text-engine/check.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "test:sync": "node --import ./scripts/register-ts.mjs scripts/test-sync-merge.mjs",
    "test:sync-store": "node --import ./scripts/register-ts.mjs scripts/test-sync-store.mjs",
    "test:sync-client": "node --import ./scripts/register-ts.mjs scripts/test-sync-client.mjs",
    "test:leaderboard-rules": "node --import ./scripts/register-ts.mjs scripts/test-leaderboard-rules.mjs",
    "test:leaderboard-store": "node --import ./scripts/register-ts.mjs scripts/test-leaderboard-store.mjs",
    "test:accounts": "node --import ./scripts/register-ts.mjs scripts/test-accounts-db.mjs"
  },
  "dependencies": {
    "better-auth": "^1.7.28",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.17.0",
    "next": "16.2.7",
    "pg": "^8.23.1",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
